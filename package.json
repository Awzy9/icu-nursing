{
  "name": "icu-nurse-knowledge-map",
  "version": "0.1.0",
  "private": true,
  "description": "ICU Nurse Knowledge Map - From Knowledge to Bedside Competence.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && npm run typecheck:schemas",
    "mobile:install": "npm ci --prefix mobile",
    "typecheck:mobile": "npm run typecheck --prefix mobile",
    "typecheck:schemas": "tsc -p packages/schemas/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "build:live": "NEXT_DIST_DIR=.next-live next build",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "live:env": "tsx scripts/live/write-env.ts",
    "live:migrate": "tsx scripts/live/apply-migrations.ts",
    "live:verify": "tsx scripts/live/verify-schema.ts",
    "live:advisors": "tsx scripts/live/advisors.ts",
    "live:auth": "tsx scripts/live/configure-auth.ts",
    "live:cleanup": "tsx scripts/live/cleanup-test-users.ts",
    "validate:drafts": "tsx scripts/validate-drafts.ts",
    "validate:skills": "tsx scripts/validate-skill-drafts.ts",
    "validate:medications": "tsx scripts/validate-medication-drafts.ts",
    "validate:scenarios": "tsx scripts/validate-scenario-drafts.ts",
    "validate:equipment": "tsx scripts/validate-equipment-drafts.ts",
    "validate:mcq": "tsx scripts/validate-mcq-expansion.ts",
    "validate:all": "npm run validate:drafts && npm run validate:skills && npm run validate:medications && npm run validate:scenarios && npm run validate:equipment && npm run validate:mcq",
    "register:drafts": "tsx scripts/build-draft-register.ts && tsx scripts/build-draft-index.ts",
    "test:audit": "for s in 1 2 3 4 5; do FUZZ_SEED=$s FUZZ_STEPS=3000 vitest run --config vitest.db.config.ts tests/db/audit-fuzz.test.ts tests/db/audit-matrix.test.ts tests/db/audit-views.test.ts || exit 1; done",
    "smoke": "tsx scripts/smoke.ts",
    "live:email:preflight": "tsx scripts/live/email-preflight.ts",
    "live:email:builtin": "tsx scripts/live/email-builtin.ts",
    "live:smtp": "tsx scripts/live/configure-smtp.ts",
    "live:captcha": "tsx scripts/live/configure-captcha.ts",
    "seed:question-fixtures": "tsx scripts/seed-synthetic-questions.ts",
    "test:e2e:qb": "playwright test tests/e2e/question-bank.spec.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "next": "~15.5.29",
    "next-intl": "^4.15.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-config-next": "~15.5.29",
    "jsdom": "^26.0.0",
    "pg": "^8.13.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
