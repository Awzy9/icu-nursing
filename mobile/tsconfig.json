{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": [
      "react-native"
    ],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "strict": true,
    "paths": {
      "@icu/schemas": [
        "../packages/schemas/src/index.ts"
      ],
      "@icu/schemas/*": [
        "../packages/schemas/src/*"
      ],
      "@icu/fixtures/*": [
        "../packages/fixtures/*"
      ],
      "zod": [
        "./node_modules/zod"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-ios",
    "babel.config.js",
    "metro.config.js",
    "android",
    "ios"
  ]
}
