{
  "expo": {
    "name": "Nursing Mastery",
    "slug": "nursing-mastery",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2239",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.nursingmastery.app",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.nursingmastery.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "platforms": [
      "android",
      "ios"
    ],
    "owner": "awzy9s-team",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B2239",
          "dark": {
            "backgroundColor": "#0B2239"
          }
        }
      ],
      "expo-updates"
    ],
    "scheme": "nursingmastery",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a672dfbf-3fe6-4971-8b97-0dffe86a2433"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a672dfbf-3fe6-4971-8b97-0dffe86a2433",
      "fallbackToCacheTimeout": 0
    }
  }
}
