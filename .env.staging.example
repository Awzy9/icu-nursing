# Environment variables for the Vercel STAGING project (Settings -> Environment Variables, scope: Production of the staging project).
# Every value here is PUBLIC by design (it is embedded in the browser bundle). There are NO secrets in the application:
# the Supabase secret/service key, the CAPTCHA secret, SMTP passwords and access tokens must never be added to Vercel.

NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://icu-nursing-staging.example.vercel.app      # the exact staging URL, no trailing slash
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co       # a staging project, NOT production
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...                          # the project's PUBLISHABLE key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...                                 # real Turnstile SITE key for the staging hostname
