# Copy to .env.local. Never commit real values.
# Public site URL (used for email redirects). Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (create your own project; no shared/production project is used by this repo).
# If both are empty the app runs in DEMO MODE with synthetic content and no accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: the Supabase service-role key is intentionally NOT used by this application.
# Privileged operations run through SECURITY DEFINER database functions with explicit role checks.

# Question bank backend (optional). "fixtures" = synthetic, nonclinical development questions held in memory (refused when
# NEXT_PUBLIC_APP_ENV=production); "database" = Supabase functions behind the content gate. Default: fixtures in demo mode, else database.
# QUESTION_BANK_MODE=fixtures
